<Window x:Class="InformationSystem.Presentation.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="О программе"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Border CornerRadius="15" Padding="20"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Effect="{DynamicResource MaterialDesignElevation3}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                <TextBlock Text="Информационная система предприятия"
                           FontSize="20" FontWeight="Bold" TextAlignment="Center"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource MaterialDesignBody}"/>

                <TextBlock Text="Версия: 1.0.0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="Gray" Margin="0,0,0,10"
                           TextAlignment="Center"/>

                <TextBlock Text="Программа предназначена для автоматизации бизнес-процессов предприятия, включая учет финансов, товаров, работников и аналитики. Поддерживает разграничение прав пользователей, модульную архитектуру и расширенные функции администрирования."
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Margin="0,0,0,20"
                           TextAlignment="Center"
                           Width="500"/>

                <Separator Margin="0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <Button Content="ОК"
                            Width="100"
                            Height="35"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="Close_Click"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            Foreground="Green"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>