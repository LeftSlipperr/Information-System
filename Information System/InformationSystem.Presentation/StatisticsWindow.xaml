<Window x:Class="InformationSystem.Presentation.ViewModel.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Статистика"
        Height="600" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Статистика по таблице:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox Name="ChartTypeComboBox" Width="200" Margin="0,0,10,0" SelectionChanged="ChartTypeComboBox_SelectionChanged"
                      Style="{StaticResource MaterialDesignDataGridComboBox}">
                <ComboBoxItem Content="Столбчатая" Tag="Column"/>
                <ComboBoxItem Content="Линейная" Tag="Line"/>
                <ComboBoxItem Content="Круговая" Tag="Pie"/>
            </ComboBox>

            <ComboBox Name="ParameterComboBox" Width="200" Margin="0,0,10,0"
                      DisplayMemberPath="Display" SelectedValuePath="Field" Style="{StaticResource MaterialDesignDataGridComboBox}"/>

            <Button Content="Построить график" Width="170" Click="BuildChart_Click" Style="{StaticResource MaterialDesignFlatButton}"/>

            <DatePicker x:Name="DateFromPicker"
            Width="140"
            Margin="0,0,10,0"
            materialDesign:HintAssist.Hint="Дата от" />

            <DatePicker x:Name="DateToPicker"
            Width="140"
            Margin="0,0,10,0"
            materialDesign:HintAssist.Hint="Дата до" />

            <Button Content="Применить" Width="110" Click="ApplyDateFilter_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <lvc:CartesianChart Name="MainCartesianChart" LegendLocation="Right" Visibility="Collapsed"/>
            <lvc:PieChart Name="MainPieChart" LegendLocation="Right" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>