<Window x:Class="InformationSystem.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationSystem.Presentation"
        mc:Ignorable="d"
        Title="Login" Height="400" Width="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        AllowsTransparency="True" WindowStyle="None">

    <Grid>
        <!-- Тень вокруг основного контейнера -->
        <Border Background="White" Padding="20" CornerRadius="20"
                Effect="{DynamicResource ShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель с кнопками управления -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Login" FontSize="24" FontWeight="Bold"
                               Foreground="Black" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗕" Width="30" Height="30" Click="Minimize_Click"
                                Background="Transparent" BorderThickness="0"/>
                        <Button Content="🗖" Width="30" Height="30" Click="Maximize_Click"
                                Background="Transparent" BorderThickness="0"/>
                        <Button Content="✖" Width="30" Height="30" Click="Close_Click"
                                Background="Transparent" BorderThickness="0" Foreground="Red"/>
                    </StackPanel>
                </DockPanel>

                <!-- Поле логина -->
                <Border Grid.Row="1" Background="#E0E0E0" Padding="5" Margin="0,0,0,10"
                        CornerRadius="10">
                    <Grid>
                        <TextBox Name="UsernameTextBox" FontSize="16" Background="Transparent"
                                 BorderThickness="0" Padding="5" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Поле пароля с глазиком -->
                <Border Grid.Row="2" Background="#E0E0E0" Padding="5" Margin="0,0,0,10" CornerRadius="10">
                    <Grid>
                        <!-- PasswordBox -->
                        <PasswordBox x:Name="PasswordBox"
                         FontSize="16" Background="Transparent"
                         BorderThickness="0" Padding="5" Margin="10,0,35,0"/>

                        <TextBox x:Name="PasswordTextBox"
                         FontSize="16" Background="Transparent"
                         BorderThickness="0" Padding="5" Margin="10,0,35,0"
                         Visibility="Collapsed"/>   

                        <!-- Кнопка-глаз -->
                        <Button Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent"
                BorderThickness="0" Click="TogglePasswordVisibility">
                            <Image Name="EyeIcon" Width="20" Height="20"
                                   Source="pack://application:,,,/Resources/eye_closed.png"/>
                        </Button>
                    </Grid>
                </Border>


                <!-- Кнопка входа с тенью -->
                <Button Grid.Row="3" Content="Login" FontSize="16" FontWeight="Bold"
                        Background="#4CAF50" Foreground="White" Height="40" Margin="0,10,0,0"
                        BorderThickness="0" Cursor="Hand" Click="LoginButton_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
