<Window x:Class="InformationSystem.Presentation.AccountantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationSystem.Presentation" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Панель бухгалтера"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Меню -->
            <RowDefinition Height="Auto" />
            <!-- Кнопки управления -->
            <RowDefinition Height="Auto"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
      Style="{StaticResource MaterialDesignMenu}"
      Background="{DynamicResource MaterialDesignPaper}"
      Foreground="{DynamicResource MaterialDesignBody}"
      Padding="10,0">
            <MenuItem Header="_Файл"  FontSize="12">
                <MenuItem Header="Импорт из Google-таблицы..."
       Click="ImportFromGoogleSheets_Click" FontSize="12">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="GoogleSpreadsheet"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Экспорт" FontSize="12">
                    <MenuItem Header="В CSV"
   Click="ExportToCsv_Click"
   FontSize="12">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FileDelimited"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="В Word"
   Click="ExportInvoice_Click"
   FontSize="12">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FileWord"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <Separator/>
                <MenuItem Header="Выход"
       Click="Close_Click"  FontSize="12">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="ExitToApp"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Инструменты" FontSize="12">
                <MenuItem Header="Курс валют" Click="Exchange_Click"/>
                <MenuItem Header="Прогноз баланса" Click="Balance_Click"/>
            </MenuItem>
            <MenuItem Header="_Справка" FontSize="12">
                <MenuItem Header="О программе..." Click="About_Click" FontSize="12"/>
            </MenuItem>
        </Menu>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,5,0">
            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="🗕" Click="Minimize_Click"/>
            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="🗖" Click="Maximize_Click"/>
            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="✖" Click="Close_Click" Foreground="Red"/>
        </StackPanel>

        <!-- Контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Меню (красивое) -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Таблицы" FontSize="18" FontWeight="SemiBold" Margin="10"/>

                <ListView Name="TablesListView" SelectionChanged="TablesListView_SelectionChanged"
          Style="{StaticResource MaterialDesignListBox}" Margin="0,10,0,0">
                    <ListViewItem Tag="Income">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashPlus" Margin="0,0,10,0"/>
                            <TextBlock Text="Доходы"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Expense">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMinus" Margin="0,0,10,0"/>
                            <TextBlock Text="Расходы"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="BalanceAnalysis">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cash" Margin="0,0,10,0"/>
                            <TextBlock Text="Баланс предприятия"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="DebtPayable">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CreditCardMinus" Margin="0,0,10,0"/>
                            <TextBlock Text="Кредиторская задолженность"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="FinishedGoodsWarehouse">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package" Margin="0,0,10,0"/>
                            <TextBlock Text="Оптовая продажа"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="RawMaterialWarehouse">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageOpen" Margin="0,0,10,0"/>
                            <TextBlock Text="Расходы на сырье"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Salary">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BankMinus" Margin="0,0,10,0"/>
                            <TextBlock Text="Расходы на зарплаты"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="TradePointEconomics">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterPointOfSaleCheck" Margin="0,0,10,0"/>
                            <TextBlock Text="Экономика торговых точек"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </StackPanel>

            <!-- Правая часть -->
            <StackPanel Grid.Column="1">
                <!-- Заголовок и обновление -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Name="TableTitle"
                               Text="Выберите таблицу"
                               FontSize="20"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>
                    <Button Content="🔄" ToolTip="Обновить" Width="40" Height="40"
                            Click="RefreshTable_Click"
                            Style="{StaticResource MaterialDesignFloatingActionButton}" />
                </DockPanel>
                <StackPanel Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,10" ItemHeight="35">
                        <!-- Строка поиска -->
                        <TextBox Name="SearchTextBox"
                         Width="200"
                         Height="35"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource MaterialDesignTextBox}"
                         materialDesign:HintAssist.Hint="Поиск..."
                         FontSize="14" />

                        <DatePicker x:Name="DateFromPicker"
                        Width="140"
                        Height="40"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        materialDesign:HintAssist.Hint="Дата от"
                        materialDesign:HintAssist.FloatingScale="1.0"
                        materialDesign:HintAssist.FloatingOffset="0,-8"
                        materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                        Background="{DynamicResource MaterialDesignPaper}"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        BorderThickness="0"
                        Padding="10,0"/>

                        <DatePicker x:Name="DateToPicker"
                        Width="140"
                        Height="40"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        materialDesign:HintAssist.Hint="Дата до"
                        materialDesign:HintAssist.FloatingScale="1.0"
                        materialDesign:HintAssist.FloatingOffset="0,-8"
                        materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                        Background="{DynamicResource MaterialDesignPaper}"
                        Foreground="{DynamicResource MaterialDesignBody}"
                        BorderThickness="0"
                        Padding="10,0"/>


                        <!-- Кнопка поиска -->
                        <Button Content="🔍"
                        Click="Search_Click"
                        Width="40"
                        Height="35"
                        Background="{x:Null}"
                        BorderThickness="0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Найти"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Padding="0"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Кнопки действий -->
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Добавить"
                            Click="AddRecord_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Изменить"
                            Click="EditRecord_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Удалить"
                            Click="DeleteRecord_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Red"/>
                    <Button Content="Статистика"
                            Click="Statistics_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0"/>

                </WrapPanel>
                <!-- Таблица -->
                <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Visibility="Visible"
                  Margin="0,0,0,10">
                    <DataGrid Name="MainDataGrid"
          Grid.Row="2"
          AutoGenerateColumns="True"
          AutoGeneratingColumn="MainDataGrid_AutoGeneratingColumn"
          IsReadOnly="False"
          CanUserAddRows="True"
          CanUserDeleteRows="True"
          SelectionMode="Single"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
          Style="{StaticResource MaterialDesignDataGrid}"
          RowBackground="{DynamicResource MaterialDesignPaper}"
          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}"
          Margin="0,0,0,10"
          MaxHeight="500" />

                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
