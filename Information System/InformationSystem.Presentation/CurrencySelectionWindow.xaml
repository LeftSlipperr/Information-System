<Window x:Class="InformationSystem.Presentation.CurrencySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationSystem.Presentation"
        mc:Ignorable="d"
        Title="Выбор валюты и курса" Height="200" Width="300">
    <StackPanel Margin="10" VerticalAlignment="Center">
        <TextBlock Text="Выберите валюту:" Margin="0,0,0,5"/>
        <ComboBox x:Name="CurrencyComboBox" SelectedIndex="0">
            <ComboBoxItem Content="USD"/>
            <ComboBoxItem Content="EUR"/>
            <ComboBoxItem Content="RUB"/>
            <ComboBoxItem Content="UAH"/>
            <ComboBoxItem Content="MDL"/>
        </ComboBox>

        <Button Content="ОК" Margin="0,10,0,0" Click="Ok_Click"/>
    </StackPanel>
</Window>