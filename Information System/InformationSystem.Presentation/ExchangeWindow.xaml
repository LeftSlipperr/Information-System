<Window x:Class="InformationSystem.Presentation.ExchangeWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Курсы валют"
        Height="400" Width="600"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <DataGrid x:Name="CurrencyGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          RowHeight="50"
          Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Флаг" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Flag}" Width="40" Height="30"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Валюта" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Курс" Binding="{Binding Rate}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
